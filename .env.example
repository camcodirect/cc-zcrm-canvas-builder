# Copy this file to .env and fill in the real values.
# .env is gitignored. Never commit it, never paste these values into chat,
# a doc, or a capture file.

# --- Zoho OAuth (self-client or server-based app from api-console.zoho.com) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Long-lived. Generated once via the authorization-code flow, then reused.
# Zoho refresh tokens do not expire unless revoked.
ZOHO_REFRESH_TOKEN=

# --- Data centre ---
# Must match the DC the org lives in. Camco is .com.
# Others: .eu, .in, .com.au, .jp, .ca
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com

# The Canvas save call is confirmed working against crm.zoho.com with a Bearer
# token (John's Postman request returns 200). Kept configurable in case a future
# org needs www.zohoapis.com instead.
ZOHO_API_HOST=https://crm.zoho.com

# --- Org ---
# Camco production org.
ZOHO_ORG_ID=647376701

# --- Scopes ---
# Scopes are baked into the refresh token when it is generated; they are NOT sent
# per request, so nothing below is read by the code. Recorded here so the token can
# be regenerated with the same access later.
#
# Minimum for this project (the Canvas save call plus field/module lookup):
#   ZohoCRM.settings.canvas.ALL
#   ZohoCRM.settings.fields.READ
#   ZohoCRM.settings.modules.READ
#   ZohoCRM.settings.layouts.READ
#   ZohoCRM.settings.related_lists.READ
#
# Full CRM API access — use this string when generating the refresh token at
# api-console.zoho.com if you want the program unrestricted:
#
#   ZohoCRM.modules.ALL,ZohoCRM.settings.ALL,ZohoCRM.users.ALL,ZohoCRM.org.ALL,
#   ZohoCRM.bulk.ALL,ZohoCRM.coql.READ,ZohoCRM.notifications.ALL,
#   ZohoCRM.attachments.ALL,ZohoCRM.templates.ALL,ZohoSearch.securesearch.READ
#
# Notes:
#   - ZohoCRM.settings.ALL covers canvas, fields, modules, layouts and related lists.
#   - ZohoCRM.modules.ALL covers record read/write across all modules.
#   - Scopes are comma-separated with NO spaces.
#   - Changing scopes requires generating a NEW refresh token; existing ones keep
#     whatever they were created with.
